<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - FastRole</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body style="background:#f5f7fb;">

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg bg-light px-3 shadow-sm">
  <div class="container-fluid">

    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/assets/job.png" class="me-2"
           style="max-height: 80px; border-radius: 100px;">
      <span class="fw-semibold fs-5 text-dark">FastRole</span>
    </a>

    <!-- Toggle -->
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navBar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navBar">

      <!-- Links -->
      <ul class="navbar-nav me-auto ms-3">

        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/jobs">Jobs</a>
        </li>

        <% if (user) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
            Recruiter
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/jobs/post-job">Post Job</a></li>
            <li><a class="dropdown-item" href="/jobs/dashboard">Dashboard</a></li>
            <li><a class="dropdown-item" href="/logout">Logout</a></li>
          </ul>
        </li>
        <% } %>

      </ul>

      <!-- Right side -->
      <% if (user) { %>
        <a href="/jobs" class="btn btn-success me-2">Jobs</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
      <% } %>

    </div>
  </div>
</nav>

<!-- ================= LOGIN SECTION ================= -->

<div class="container d-flex justify-content-center align-items-center"
     style="height: calc(100vh - 100px);">

  <div class="card p-4 shadow"
       style="width: 400px; border-radius: 15px;">

    <!-- LOGIN -->
    <div id="loginForm">
      <h3 class="text-center mb-4">Login</h3>

      <form action="/login" method="POST">
        <div class="mb-3">
          <input type="email" name="email"
            class="form-control"
            placeholder="Enter Email" required>
        </div>

        <div class="mb-3">
          <input type="password" name="password"
            class="form-control"
            placeholder="Enter Password" required>
        </div>

        <button class="btn btn-primary w-100">Login</button>
      </form>

      <p class="text-center mt-3">
        Don't have an account?
        <a href="#" onclick="showSignup()">Sign Up</a>
      </p>
    </div>

    <!-- SIGNUP -->
    <div id="signupForm" style="display:none;">
      <h3 class="text-center mb-4">Sign Up</h3>

      <form action="/register" method="POST">
        <div class="mb-3">
          <input type="text" name="name"
            class="form-control"
            placeholder="Enter Name" required>
        </div>

        <div class="mb-3">
          <input type="email" name="email"
            class="form-control"
            placeholder="Enter Email" required>
        </div>

        <div class="mb-3">
          <input type="password" name="password"
            class="form-control"
            placeholder="Enter Password" required>
        </div>

        <button class="btn btn-success w-100">Register</button>
      </form>

      <p class="text-center mt-3">
        Already have an account?
        <a href="#" onclick="showLogin()">Login</a>
      </p>
    </div>

  </div>
</div>

<!-- ================= SCRIPT ================= -->
<script>
  function showSignup() {
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('signupForm').style.display = 'block';
  }

  function showLogin() {
    document.getElementById('signupForm').style.display = 'none';
    document.getElementById('loginForm').style.display = 'block';
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>