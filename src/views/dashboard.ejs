<h3>Applicants</h3>

<table class="table">
  <tr>
    <th>Name</th>
    <th>Email</th>
    <th>Phone</th>
  </tr>

  <% applications.forEach(a => { %>
    <tr>
      <td><%= a.name %></td>
      <td><%= a.email %></td>
      <td><%= a.phone %></td>
      <td><button class="btn btn-primary">View Resume</button></td>
    </tr>
  <% }) %>
</table>