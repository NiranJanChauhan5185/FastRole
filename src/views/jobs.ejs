<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Jobs</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background:#f5f7fb;">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm px-4">
  <a class="navbar-brand d-flex align-items-center" href="#">
          <img
            src="/assets/job.png"
            class="me-2"
            style="max-height: 80px; border-radius: 100px"
            alt="Logo"
          />
          <span class="fw-semibold fs-5 text-dark">FastRole</span>
        </a>

  <div class="collapse navbar-collapse">
    <ul class="navbar-nav ms-4">
      <li class="nav-item"><a class="nav-link text-dark" href="/">Home</a></li>
      <li class="nav-item"><a class="nav-link text-dark" href="/jobs">Jobs</a></li>
      <li class="nav-item"><a class="nav-link text-dark" href="#">Recruiter</a></li>
    </ul>
  </div>

  <div class="d-flex">
    <input type="text" class="form-control me-2" placeholder="Search jobs..." style="width:250px;">
    <button class="btn btn-primary">Search</button>
  </div>
</nav>

<!-- MAIN -->
<div class="container-fluid mt-4">
  <div class="row">

    <!-- SIDEBAR FILTER -->
    <div class="col-md-3">
      <div class="bg-white p-3 rounded shadow-sm">

        <div class="d-flex justify-content-between">
          <h6 class="fw-bold">Job filters</h6>
          <a href="#" style="text-decoration:none;">Clear all</a>
        </div>

        <hr>

        <h6 class="fw-bold">Date posted</h6>
        <div class="form-check">
          <input class="form-check-input" type="radio" checked>
          <label class="form-check-label">Past 24 hours</label>
        </div>

        <hr>

        <h6 class="fw-bold">Experience level</h6>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" checked>
          <label class="form-check-label">Entry level</label>
        </div>

        <hr>

        <h6 class="fw-bold">Job type</h6>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" checked>
          <label class="form-check-label">Full-time</label>
        </div>

      </div>
    </div>

    <!-- JOB LIST -->
    <div class="col-md-9">

      <!-- SEARCH BAR -->
      <div class="bg-white p-3 rounded shadow-sm mb-3 d-flex">
        <input type="text" class="form-control me-2" placeholder="Search job titles or keywords">
        <input type="text" class="form-control me-2" placeholder="Location">
        <button class="btn btn-primary">Search</button>
      </div>

      <div class="d-flex justify-content-between mb-3">
        <h6><%= jobs.length %> jobs found</h6>
        <select class="form-select" style="width:180px;">
          <option>Most relevant</option>
        </select>
      </div>

      <!-- 🔥 DYNAMIC JOB CARDS -->
      <% jobs.forEach(job => { %>

      <div class="bg-white p-3 rounded shadow-sm mb-3">

        <div class="d-flex">
          <img src="<%= job.companyLogo %>"
               style="width:50px;height:50px;object-fit:contain;margin-right:15px;">

          <div style="flex:1;">
            <h5 class="fw-bold"><%= job.title %></h5>
            <p class="mb-1 text-muted"><%= job.company %></p>

            <small class="text-muted">
              <%= job.location.city %> <%= job.location.country %> <%= job.location.type %>
            </small>

            <div class="mt-2">
              <span class="badge bg-light text-dark"><%= job.experience %></span>
              <span class="badge bg-light text-success">
                ₹<%= job.salary.min %> - ₹<%= job.salary.max %><%= job.salary.currency %>
              </span>
              <span class="badge bg-light text-dark">
                <%= job.companyInfo?.employees || '' %>
              </span>
              <span class="badge bg-success">Easy Apply</span>
            </div>

            <!-- SKILLS -->
            <div class="mt-2">
              <% job.skills.forEach(skill => { %>
                <span class="badge bg-light text-dark"><%= skill %></span>
              <% }) %>
            </div>

            <small class="text-muted d-block mt-2">
              <%= job.postedDate %> · <%= job.applicants %> applicants
            </small>
          </div>

          <div class="text-end">
            <button class="btn btn-outline-secondary btn-sm mb-2">Save</button><br>
            <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm">View</a>
          </div>
        </div>

      </div>

      <% }) %>

    </div>
  </div>
</div>

</body>
</html>